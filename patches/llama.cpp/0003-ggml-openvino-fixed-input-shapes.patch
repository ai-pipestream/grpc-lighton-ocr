+static const ggml_tensor * view_root(const ggml_tensor * tensor) {
+    while (tensor != nullptr && tensor->op == GGML_OP_VIEW && tensor->src[0] != nullptr) {
+        tensor = tensor->src[0];
+    }
+    return tensor;
+}
+
+// Runs once, on the graph the model is converted from. update_io() rebinds the decoder to
+// later graphs and must not move this record with it.
+void GgmlOvDecoder::record_fixed_inputs() {
+    m_fixed_inputs.clear();
+    for (const auto & [name, tensor] : m_inputs) {
+        const auto input = m_model_inputs.find(name);
+        if (input == m_model_inputs.end() || !input->second.shape.is_static()) {
+            continue;
+        }
+        bool found = false;
+        for (int n = 0; n < m_cgraph->n_nodes && !found; n++) {
+            for (int j = 0; j < GGML_MAX_SRC && !found; j++) {
+                const ggml_tensor * src = m_cgraph->nodes[n]->src[j];
+                if (src == nullptr || (src != tensor && view_root(src) != tensor)) {
+                    continue;
+                }
+                FixedInput fixed{n, j, src != tensor, {}};
+                std::copy(std::begin(tensor->ne), std::end(tensor->ne), std::begin(fixed.ne));
+                m_fixed_inputs.push_back(fixed);
+                found = true;
+            }
+        }
+    }
+}
+
+bool GgmlOvDecoder::fixed_inputs_match(const ggml_cgraph * cgraph) const {
+    for (const auto & fixed : m_fixed_inputs) {
+        if (fixed.node >= cgraph->n_nodes) {
+            return false;
+        }
+        const ggml_tensor * tensor = cgraph->nodes[fixed.node]->src[fixed.src];
+        if (fixed.through_views) {
+            tensor = view_root(tensor);
+        }
+        if (tensor == nullptr || !std::equal(std::begin(fixed.ne), std::end(fixed.ne), std::begin(tensor->ne))) {
+            return false;
+        }
+    }
+    return true;
+}
